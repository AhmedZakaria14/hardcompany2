# AI Studio Applet Environment Variables
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Client Configuration (Vite)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_FIRESTORE_DATABASE_ID=ai-studio-airealestate-4f5d4a08-7587-413f-8832-6058c6011951

# Local Firebase Emulator Configuration
VITE_USE_FIREBASE_EMULATOR=false
VITE_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
VITE_FIREBASE_FIRESTORE_EMULATOR_HOST=localhost:8080
VITE_FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199

# Privileged Server Runtime (Node.js Express Backend)
FIREBASE_SERVICE_ACCOUNT_KEY=your_base64_or_json_service_account_credentials

# Integrations & Maps
VITE_CRM_WEBHOOK_URL=https://crm.hard.sa/api/webhook/leads
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_SUPABASE_URL=https://your_supabase_project.supabase.co
